<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Dynamic Multi-Signal Simulation Report</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/uplot@1.6.25/dist/uPlot.min.css">
  <script src="https://cdn.jsdelivr.net/npm/uplot@1.6.25/dist/uPlot.iife.min.js"></script>
  <style>
    html, body {
      height: 100%;
      margin: 0;
      padding: 20px;
      box-sizing: border-box;
      font-family: system-ui, -apple-system, sans-serif;
      background: #f4f4f9;
    }
    .chart-container {
      display: flex;
      flex-direction: column;
      gap: 12px;
      background: #ffffff;
      padding: 16px;
      border-radius: 8px;
      width: 100%;
      min-width: 320px;
      min-height: 500px;
      height: calc(100vh - 80px);
      box-sizing: border-box;
      overflow-x: auto;
    }
    .chart-wrapper {
      display: flex;
      flex-direction: column;
    }
    .chart-wrapper > div {
      flex: 1;
    }
  </style>
</head>
<body>

  <div class="chart-container" id="container"></div>

  <script type="application/json" id="plot-data">{{ plot_data_json|safe }}</script>
  <script>
{% include "multi_signal_report.js" %}
  </script>

</body>
</html>
